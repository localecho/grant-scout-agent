# Copy to .env and fill in. Never commit the real .env file.

# Which model provider Strands should use. Strands is provider-agnostic; this repo
# defaults to OpenRouter (hundreds of models behind one key, cheap for hackathon iteration)
# and also supports Amazon Bedrock unmodified -- see src/agent.py.
GRANT_SCOUT_MODEL_PROVIDER=openrouter

# Required if GRANT_SCOUT_MODEL_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model id for either provider.
# OpenRouter example:  anthropic/claude-haiku-4.5
# Bedrock example:     anthropic.claude-haiku-4-5-20251001-v1:0
GRANT_SCOUT_MODEL_ID=

# Only used if GRANT_SCOUT_MODEL_PROVIDER=bedrock (requires AWS credentials configured
# normally, e.g. via `aws configure` or environment variables -- not set here).
AWS_REGION=us-east-1
